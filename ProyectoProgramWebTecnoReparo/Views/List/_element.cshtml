@model ProyectoProgramWebTecnoReparo.Models.VMs.ListCatVM

@if (Model is not null)
{
    <div class="row g-4 justify-content-center">
        @foreach (var pic in Model.Products)
        {
            <div class="col-12 col-md-4">
                <div class="card" style="width: 15rem;">
                    <img src="/img/@pic.Image" class="card-img-top" alt="@pic.Name">
                    <div class="card-body">
                        <h5 class="card-title">@pic.Name</h5>
                        <p class="card-text">@pic.Description</p>
                        <p class="card-text">@(pic._Category?.Name != null ?  pic._Category.Name : " ")</p>
                    </div>
                    <a href="#" class="btn btn-primary">Button</a>
                </div>
            </div>
        }
    </div>
}