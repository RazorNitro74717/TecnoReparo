@model List<Product>

@{
    ViewData["Title"] = "TecnoReparo";
}

<div class=text-center>
    <h1 class=“display-4”>TecnoReparo</h1>
    <h2>Presupuestos y armados de PCs gamers</h2>
    <div class="splash-text" style="font-size: 1.5rem; color: darkorange; text-align: center; margin-top: 20px;">@ViewBag.SplashText</div>
    <br />
    <h2>Componentes destacados</h2>

    <br />
    <div class= container-text-center>
        <div id="carouselIndex" class="carousel carousel-dark slide">
                <div class="carousel-indicators">
                    @for(int i = 0; i < Model.Count(); i++){
                    <button type="button" data-bs-target="#carouselIndex" data-bs-slide-to="@i" class="@(i == 0? "active" : " ")" aria-current="@(i == 0? "true" : "false")" aria-label="@(i+1)"></button>
                    }
                </div>

                <div class="carousel-inner">
                @for (int i = 0; i < Model.Count(); i++)
                {
                    var product = Model.ElementAt(i);
                    <div class="carousel-item @(i == 0 ? "active" : " ") text-center">
                        <img src="/img/@product.Image" class="d-block mx-auto w-75" alt="/img/not_available.jpg">
                        <div class="mt-3">
                            <h5>@product.Name</h5>
                            <p>@product.Description</p>
                        </div>
                    </div>
                }
                </div>
            <br />
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselIndex" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselIndex" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
        
        </div>
    </div>
    <br />
 
</div>

<div class="position-fixed bottom-0 end-0 p-3">
    <div id="OkToast" class="toast">
        <div class="toast-header">
            <strong class="me-auto">Solicitud de contacto enviada!</strong>
            <small>Reciente</small>
            <button class="btn-close" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body">
            Nos pondremos en contacto con usted en los proximos dias
        </div>
    </div>
</div>


@section Scripts {

    <script>
        @if (TempData["ShowToast"] != null)
        {
            <text>
                            var context = document.getElementById('OkToast');
            var toast = new bootstrap.Toast(context);
            toast.show();
            </text>
        }
    </script>
}





